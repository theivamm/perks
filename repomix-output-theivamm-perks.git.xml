}

export function normalizeEmptyPreferences(preferences = {}) {
  const prefs = { ...(preferences || {}) };
  for (const cat of CATS) {
    const v = prefs[cat.key];
    if (cat.single) {
      if (v === undefined || v === null || v === '') prefs[cat.key] = cat.none.value;
    } else if (!Array.isArray(v) || v.length === 0) {
      prefs[cat.key] = [cat.none.value];
    }
  }
  return prefs;
}

export function profileProgress({ name = '', phone = '', email = '', preferences = {} } = {}) {
  const prefs = {
    diet: [], allergies: [], religions: [], toppings: [], packaging: [], alerts: [],
    milk: '', sweetener: '', coffee: '', pickup: '', payment: '',
    ...(preferences || {}),
  };
  const entries = [
    { label: 'Nombre', filled: Boolean(name) },
    { label: 'Teléfono', filled: Boolean(phone) },
    { label: 'Email', filled: Boolean(email) },
    ...CATS.map((cat) => {
      const v = prefs[cat.key];
      return {
        label: cat.title,
        filled: cat.single ? Boolean(v) : Boolean(v && v.length > 0),
      };
    }),
  ];
  const done = entries.filter((e) => e.filled).length;
  const total = entries.length;
  const missing = entries.filter((e) => !e.filled).map((e) => e.label);
  return { done, total, pct: Math.round((done / total) * 100), missing };
}

export function prefsSummary(preferences = {}) {
  const prefs = {
    diet: [], allergies: [], religions: [], toppings: [], packaging: [], alerts: [],
    milk: '', sweetener: '', coffee: '', pickup: '', payment: '', birthday: '', schedule: '',
    ...(preferences || {}),
  };

  const groups = [];
  for (const cat of CATS) {
    const picked = [];
    if (cat.single) {
      const v = prefs[cat.key];
      if (v && v !== cat.none.value) {
        const opt = cat.options.find((o) => o.value === v);
        if (opt) picked.push(opt);
      }
    } else if ((prefs[cat.key] || []).length > 0) {
      for (const v of prefs[cat.key]) {
        const opt = cat.options.find((o) => o.value === v);
        if (opt) picked.push(opt);
      }
    }
    if (picked.length > 0) {
      groups.push({
        key: cat.key,
        title: cat.title,
        icon: cat.icon,
        gradient: cat.gradient,
        border: cat.border,
        badge: cat.badge,
        tint: cat.tint,
        items: picked,
      });
    }
  }
  for (const f of TEXT_FIELDS) {
    if (prefs[f.key]) {
      groups.push({
        key: f.key,
        title: f.title,
        icon: f.icon,
        gradient: f.gradient,
        border: f.border,
        badge: f.badge,
        tint: f.tint,
        value: f.key === 'birthday' && prefs[f.key] ? `Cumpleaños: ${prefs[f.key]}` : prefs[f.key],
      });
    }
  }
  return groups;
}
