            <p className="w-full truncate text-lg font-extrabold sm:text-2xl">{coupon?.title || 'Cargando cupón…'}</p>
            {coupon?.description && (
              <p className="mt-1 w-full text-sm font-semibold leading-relaxed text-white/90">{coupon.description}</p>
